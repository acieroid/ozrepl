#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -n "${OZREPL_VIM:-}" ]; then
    editor=$OZREPL_VIM
elif command -v nvim >/dev/null 2>&1; then
    editor=nvim
elif command -v vim >/dev/null 2>&1; then
    editor=vim
else
    echo "ozrepl: neither neovim nor vim was found" >&2
    exit 127
fi

# Prepending instead of replacing the runtime path preserves user config.
exec "$editor" \
    --cmd "set runtimepath^=$script_dir/vim" \
    --cmd "filetype plugin indent on" \
    --cmd "syntax enable" \
    "$@"
